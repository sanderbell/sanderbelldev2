  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && esbuild src/hui-login.ts --bundle --format=esm --outfile=dist/hui/login.js && esbuild src/hui-pwa.ts --bundle --format=esm --outfile=dist/hui/pwa.js",
